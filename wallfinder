#!/usr/bin/env bash
# wallpaper selector for wayland compositors
# you need to have fzf, chafa, swaybg, libnotify

# check dependencies
for cmd in fzf chafa swaybg notify-send; do
    command -v "$cmd" &> /dev/null || { echo "error: $cmd not found."; exit 1; }
done

# escolhe o protocolo de imagem do terminal (kitty, sixel ou fallback ascii)
# da pra forcar com: WALLFINDER_FORMAT=kitty|sixels|iterm|symbols
if [[ -n $WALLFINDER_FORMAT ]]; then
    format="$WALLFINDER_FORMAT"
else
    # dentro do tmux o TERM e do tmux; pergunta pro tmux qual e o terminal de fora
    outer_term="$TERM"
    if [[ -n $TMUX ]]; then
        outer_term=$(tmux display-message -p '#{client_termname}' 2>/dev/null || echo "$TERM")
    fi

    case "$outer_term" in
        foot*) format=sixels ;;
        xterm-kitty*|xterm-ghostty*|wezterm*) format=kitty ;;
        *)
            # fora do tmux, essas variaveis identificam o terminal
            if [[ -n $KITTY_WINDOW_ID || $TERM_PROGRAM == WezTerm || $TERM_PROGRAM == ghostty ]]; then
                format=kitty
            else
                format=symbols
            fi
            ;;
    esac
fi

# o chafa so liga o passthrough sozinho quando e kitty; nos outros casos
# precisa ser dito explicitamente qual multiplexador esta no meio.
# excecao: tmux novo com suporte a sixel entende sixel sozinho, e ai o
# passthrough atrapalha.
if [[ -n $TMUX ]]; then
    # o passthrough direto nao funciona pelo fzf (o tmux repassa a imagem na
    # hora errada, ai o fzf pinta por cima). entao o caminho e o sixel nativo
    # do tmux, com um redraw no fim pra imagem nao ficar escondida.
    passthrough=none
    # o tmux so aceita sixel em DCS sem parametros (ESC P q), mas o chafa
    # manda ESC P 0;1;0 q, entao tira os parametros
    sixel_filter=" | sed 's/\\x1bP[0-9;]*q/\\x1bPq/'"
    # a imagem so aparece no proximo redraw; pede um sem esperar troca de
    # janela. o arquivo de token evita disparar varios redraws quando voce
    # passa rapido por varias imagens
    tmux_client=$(tmux display-message -p -t "$TMUX_PANE" '#{client_name}' 2>/dev/null)
    if [[ -n $tmux_client ]]; then
        token_file="/tmp/wallfinder-${TMUX_PANE#%}-refresh"
        preview_refresh="; t=\$(date +%s%N); echo \$t > '$token_file'; (sleep 0.08; [ \"\$(cat '$token_file' 2>/dev/null)\" = \"\$t\" ] && tmux refresh-client -t '$tmux_client') >/dev/null 2>&1 &"
    fi
elif [[ -n $STY ]]; then
    passthrough=screen
else
    passthrough=none
fi

# limpa a area do preview antes de desenhar, senao a imagem antiga fica
# sobrando quando a janela diminui (usa as posicoes que o fzf exporta)
clear_area='[ -n "$FZF_PREVIEW_TOP" ] && printf "\033[%s;%sH\033[J" "$((FZF_PREVIEW_TOP + 1))" "$((FZF_PREVIEW_LEFT + 1))"'

# o chafa sempre arredonda a imagem pra linhas inteiras de celula e pinta a
# sobra de preto (aquela barra embaixo). se o imagemagick estiver instalado,
# recorta a imagem no centro pra ela preencher a area sem barra e sem esticar.
magick_bin=$(command -v magick || command -v convert)
preview_helper=""
if [[ $format == sixels && -n $magick_bin ]]; then
    preview_helper=$(mktemp "${TMPDIR:-/tmp}/wallfinder-prev.XXXXXX")
    trap 'rm -f "$preview_helper"' EXIT
    cat > "$preview_helper" <<HELPER
#!/bin/sh
# recorta no centro pra caber exatamente na proporcao que o chafa usa
w=\${FZF_PREVIEW_COLUMNS:-80}
h=\$(( \${FZF_PREVIEW_LINES:-24} - 1 ))
[ "\$h" -lt 1 ] && h=1
hdr=\$(chafa --format=sixels --size "\${w}x\${h}" "\$1" 2>/dev/null | head -c 200 | tr -d '\033')
pix=\$(printf '%s' "\$hdr" | grep -aoE '"1;1;[0-9]+;[0-9]+' | head -1)
pw=\$(printf '%s' "\$pix" | cut -d';' -f3)
ph=\$(printf '%s' "\$pix" | cut -d';' -f4)
tmp=\$(mktemp "\${TMPDIR:-/tmp}/wallfinder-img.XXXXXX")
if [ -n "\$pw" ] && [ -n "\$ph" ]; then
    $magick_bin "\$1" -resize "\${pw}x\${ph}^" -gravity center -extent "\${pw}x\${ph}" png:- > "\$tmp" 2>/dev/null
fi
if [ -s "\$tmp" ]; then
    chafa --format=sixels --passthrough=$passthrough --size "\${w}x\${h}" - < "\$tmp" 2>/dev/null$sixel_filter
else
    chafa --format=sixels --passthrough=$passthrough --size "\${w}x\${h}" --margin-bottom=1 "\$1" 2>/dev/null$sixel_filter
fi
rm -f "\$tmp"
HELPER
    chmod +x "$preview_helper"
fi

if [[ -n $preview_helper ]]; then
    preview="$clear_area; '$preview_helper' {}$preview_refresh"
else
    # o tamanho fica em variavel pra ser calculado de novo a cada preview
    # (assim a imagem se ajusta quando a janela muda de tamanho)
    preview="$clear_area; chafa --format=$format --passthrough=$passthrough --size \${FZF_PREVIEW_COLUMNS}x\$((FZF_PREVIEW_LINES - 1)) --margin-bottom=1 {}$sixel_filter$preview_refresh"
fi

while true; do
    # folder selection
    selection=$( (
        echo "MANUAL: > [ TYPE PATH MANUALLY ]"
        find "$HOME" -maxdepth 4 -not -path '*/.*' -type d 2>/dev/null | awk -v home="$HOME" '
            $0 == home { next }
            {
                rel = $0; sub(home"/", "", rel);
                depth = gsub(/\//, "/", rel);
                indent = ""; for (i=0; i<depth; i++) indent = indent "    ";
                split($0, p, "/");
                print $0 ":" indent " " p[length(p)] "  (" rel ")"
            }
        '
    ) | fzf --ansi -d ":" --with-nth 2 \
            --prompt="step 1: select folder > " \
            --layout=reverse --border \
            --header="arrows to browse | enter to select | ctrl-c to exit" \
            --color="prompt:#cccccc,pointer:#cccccc,marker:#cccccc,info:#cccccc,hl:#cccccc,hl+:#cccccc")

    # exit when commanded
    [[ $? -ne 0 || -z "$selection" ]] && exit 0

    wall_dir=$(echo "$selection" | cut -d":" -f1)

    # manual path
    if [[ "$wall_dir" == "MANUAL" ]]; then
        echo ""
        read -p "enter the full path to your wallpapers: " wall_dir
        wall_dir="${wall_dir/#\~/$HOME}"
    fi

    if [[ ! -d "$wall_dir" ]]; then
        echo "error: directory $wall_dir not found."
        sleep 1
        continue
    fi

    # selecting
    while true; do
        img_selection=$(find "$wall_dir" -type f \( -iname "*.jpg" -o -iname "*.png" -o -iname "*.jpeg" \) | \
            fzf --prompt="step 2: select wallpaper > " \
                --layout=reverse --border \
                --color="prompt:#cccccc,pointer:#cccccc,marker:#cccccc,info:#cccccc,hl:#cccccc,hl+:#cccccc" \
                --preview="$preview" \
                --preview-window=right:50%:wrap \
                --bind 'resize:refresh-preview' \
                --header="enter to apply | bspace/esc to go back | ctrl-c to exit" \
                --bind "enter:execute-silent(killall swaybg 2>/dev/null; swaybg -m fill -i {} & ln -sf {} \"$wall_dir/atual.png\"; notify-send \"wallpaper applied\" \"\$(basename {})\")" \
                --bind "bspace:become(echo GO_BACK)" --bind "esc:become(echo GO_BACK)")

        res=$?
        
        # go back
        [[ "$img_selection" == "GO_BACK" ]] && break
        
        # exit if commanded
        [[ $res -eq 130 ]] && exit 0
    done
done
